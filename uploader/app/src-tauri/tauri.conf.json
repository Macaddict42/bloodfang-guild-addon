{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloodfang Uploader",
  "mainBinaryName": "Bloodfang Uploader",
  "version": "0.1.0",
  "identifier": "com.raidgroup.guilduploader",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bloodfang Uploader",
        "width": 436,
        "height": 560,
        "minWidth": 400,
        "minHeight": 240,
        "resizable": true,
        "center": true,
        "visible": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Bloodfang Guild",
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
